# SAFAR environment template. Copy to .env (root, for docker compose) and/or
# services/api/.env. Never commit a real .env file.
#
# Production checklist:
#   1. Generate SECRET_KEY:  python -c "import secrets; print(secrets.token_urlsafe(48))"
#   2. Use PostgreSQL:       DATABASE_URL=postgresql+psycopg://user:pass@host:5432/safar
#   3. Set ENVIRONMENT=production, COOKIE_SECURE=true and serve over HTTPS.
#   4. Keep SAFAR_SEED=false so demo accounts are never created.
#   5. Set CORS_ORIGINS and TRUSTED_HOSTS to your real hostname.

# ---- Backend (services/api) ----
# Local development defaults to SQLite. Production must use PostgreSQL:
DATABASE_URL=sqlite:///./safar.db

# Required in production (>= 32 characters, unique). Signs JWTs, media URLs
# and the keyed IP digests used in logs.
SECRET_KEY=change-me-to-a-long-random-string

# development | test | production
# In production the app refuses to start with a weak/default SECRET_KEY and
# expects `alembic upgrade head` to have run; it will not create tables.
ENVIRONMENT=development

# Seed the deterministic demo dataset (idempotent). Defaults to true outside
# production. Never enable in production.
SAFAR_SEED=true

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000,http://localhost:3010

# Comma-separated Host header allowlist.
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# ---- Sessions and cookies ----
# Access token lifetime (minutes). Refresh sessions last 30 days and rotate on
# every use. Keep this short in production.
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Secure cookies require HTTPS. Set false only for a local http trial.
COOKIE_SECURE=false
# lax | strict | none (none requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
# Optional cookie domain for subdomain deployments.
# COOKIE_DOMAIN=.example.com

# Only enable behind a proxy that overwrites X-Forwarded-For / X-Forwarded-Proto.
TRUST_PROXY_HEADERS=false

# ---- Abuse controls ----
RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_MINUTE=10
COMPANION_RATE_LIMIT_PER_MINUTE=20
UPLOAD_RATE_LIMIT_PER_MINUTE=30
MAX_REQUEST_BYTES=26214400

# ---- Operations ----
LOG_LEVEL=INFO
RELEASE=safar-1.0.0
# OpenAPI docs (/api/docs) are disabled in production unless set to true.
ENABLE_API_DOCS=false
# Optional Sentry-compatible DSN. No paid dependency is required; without a
# DSN error monitoring is a no-op and unhandled errors go to the JSON log.
# SENTRY_DSN=

# ---- Data retention (days; see docs/SECURITY.md) ----
RETENTION_SESSION_DAYS=30
RETENTION_INVITATION_DAYS=30
RETENTION_COMPANION_DAYS=30
RETENTION_NOTIFICATION_DAYS=180
RETENTION_AUDIT_DAYS=365
RETENTION_OFFLINE_DAYS=7

# ---- Assistant / external services ----
# Defaults make zero outbound AI calls. The assistant is deterministic grounded
# retrieval with local multilingual templates; /api/health reports
# external_ai=false and /api/ai/capabilities lists every provider state.
#
# The OpenAI settings remain completely inert: no service reads them. Wiring an
# LLM requires a separate change, a cost review and explicit approval.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Optional weather (free, no key, attribution required). disabled | open-meteo
SAFAR_WEATHER_PROVIDER=disabled
SAFAR_WEATHER_CACHE_TTL_SECONDS=1800
SAFAR_WEATHER_RATE_LIMIT_PER_MINUTE=60

# Optional page-metadata reading for Dream Import links. Off by default; the
# adapter is SSRF-guarded (public http(s) only, no redirects, 256 KB cap).
SAFAR_LINK_FETCH_ENABLED=false
SAFAR_LINK_CACHE_TTL_SECONDS=900
SAFAR_LINK_RATE_LIMIT_PER_MINUTE=10

# Local OCR for uploaded images (Tesseract must be installed on the server).
# Images are processed locally and never uploaded to a third party.
SAFAR_OCR_ENABLED=true
SAFAR_OCR_MAX_IMAGE_BYTES=10485760

# Shared provider timeout for outbound calls.
SAFAR_PROVIDER_TIMEOUT_SECONDS=3

# ---- Frontend (apps/web) ----
# Public API base URL, baked in at build time. Never put secrets in
# NEXT_PUBLIC_* variables: they are shipped to the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- docker compose only ----
# Required by docker compose for the PostgreSQL service.
POSTGRES_PASSWORD=
