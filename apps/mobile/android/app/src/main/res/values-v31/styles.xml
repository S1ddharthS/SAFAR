<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ ignores windowBackground for the splash and uses the
         system splash API instead, so the branded colours are declared here. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/safar_splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/safar_splash_background</item>
    </style>
</resources>
